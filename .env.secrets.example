# Copy to .env.secrets.local (gitignored), fill it in, then run: scripts/push-secrets.sh dev
# Values go straight to the Convex deployment; never commit the filled-in file.

# Resend API key with sending access for melos.azhao.dev
AUTH_RESEND_KEY=
# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=
# Voyage API key (dashboard.voyageai.com)
VOYAGE_API_KEY=
# Apify personal API token (console.apify.com > Settings > API & Integrations)
APIFY_TOKEN=
# Left blank, these two are generated once by the script and written back here
APIFY_WEBHOOK_SECRET=
SPOTIFY_STATE_SECRET=
# The team's school emails, comma-separated
ADMIN_EMAILS=
# One line per Spotify app, named by its label in uppercase with underscores, for example:
# SPOTIFY_CLIENT_SECRET_MELOS_ALEX=

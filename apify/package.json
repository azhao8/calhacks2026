{
  "name": "melos-event-scout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An Apify actor that finds real, ticketed events near a place and saves them in a strict, structured format.",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "apify": "^3.7.2",
    "cheerio": "^1.2.0",
    "crawlee": "^3.18.2",
    "got-scraping": "^4.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}

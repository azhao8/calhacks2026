From 64100a64675de175e58e3354caac0f8f5ea57adb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 25 Oct 2026 02:48:12 +0000
Subject: [PATCH] wire: hooks name shared liked songs properly; demo labels
 come from the fixed list

Shared liked songs are fingerprint tracks too, so the hook maps their
keys back to the song's own spelling instead of showing a raw
"title|artist" key. The demo label "urbano latino" isn't on the fixed
list; "latin trap" is. A test keeps every demo label on the list.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015guTYUBX4Ct5WtjQ9sW1zv
---
 convex/demo/fixtures.ts    | 2 +-
 convex/integration.test.ts | 9 +++++++++
 convex/matching/names.ts   | 7 ++++++-
 3 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/convex/demo/fixtures.ts b/convex/demo/fixtures.ts
index 431bb82..a5db931 100644
--- a/convex/demo/fixtures.ts
+++ b/convex/demo/fixtures.ts
@@ -82,7 +82,7 @@ export const DEMO_FIXTURES: DemoFixture[] = [
     gender: "prefer_not_to_say",
     year: "second",
     summary: "Reggaeton and Latin pop with a love for anything you can dance to.",
-    labels: ["reggaeton", "latin pop", "urbano latino"],
+    labels: ["reggaeton", "latin pop", "latin trap"],
     topArtists: ["Bad Bunny", "Karol G", "Rosalía", "Peso Pluma", "Rauw Alejandro", "J Balvin", "Kali Uchis", "Feid", "Tainy", "Dua Lipa"],
     topTracks: [["Tití Me Preguntó", "Bad Bunny"], ["Provenza", "Karol G"], ["Despechá", "Rosalía"], ["Ella Baila Sola", "Peso Pluma"], ["Todo de Ti", "Rauw Alejandro"], ["Normal", "Feid"]],
     likedSongs: [["Mi Gente", "J Balvin"], ["Telepatía", "Kali Uchis"], ["Me Porto Bonito", "Bad Bunny"], ["Levitating", "Dua Lipa"], ["Safaera", "Bad Bunny"]],
diff --git a/convex/integration.test.ts b/convex/integration.test.ts
index a776fdf..3f9516f 100644
--- a/convex/integration.test.ts
+++ b/convex/integration.test.ts
@@ -3,6 +3,7 @@ import { DEMO_FIXTURES, demoFingerprint, demoSnapshot } from "./demo/fixtures";
 import { fingerprint } from "./onboarding/snapshot";
 import { normalizeName, normalizeTrackKey } from "./lib/normalize";
 import { normalizeName as matchingNormalizeName } from "./matching/taste";
+import { TASTE_LABELS } from "./ai/labels";
 
 // Cross-stream contracts that no single stream's tests can see.
 
@@ -29,3 +30,11 @@ describe("demo and real students compare alike", () => {
     expect(demoSnapshot(DEMO_FIXTURES[0]).topTracks[0].normalizedKey).toBe(normalizeTrackKey(name, [artist]));
   });
 });
+
+describe("demo fixtures follow onboarding's rules", () => {
+  test("every demo label is on the fixed label list", () => {
+    for (const fixture of DEMO_FIXTURES) {
+      for (const label of fixture.labels) expect(TASTE_LABELS, `${fixture.key}: ${label}`).toContain(label);
+    }
+  });
+});
diff --git a/convex/matching/names.ts b/convex/matching/names.ts
index cc6e150..2f361c3 100644
--- a/convex/matching/names.ts
+++ b/convex/matching/names.ts
@@ -2,6 +2,7 @@ import type { Id } from "../_generated/dataModel";
 import type { DatabaseReader } from "../_generated/server";
 import type { HookItem } from "../ai/hooks";
 import { normalizeName, type SharedItem } from "./taste";
+import { normalizeTrackKey } from "../lib/normalize";
 
 // Fingerprints hold normalized names; hooks show the names as Spotify spells them.
 export async function hookItems(
@@ -26,11 +27,15 @@ export async function hookItems(
     for (const track of snapshot.topTracks) tracks.set(track.normalizedKey, track.name);
     for (const song of snapshot.likedSongs) {
       for (const name of song.artistNames) if (!artists.has(normalizeName(name))) artists.set(normalizeName(name), name);
+      // Liked songs are in the fingerprint's tracks too, under the same key onboarding builds.
+      const key = normalizeTrackKey(song.name, song.artistNames);
+      if (!tracks.has(key)) tracks.set(key, song.name);
     }
   }
   return shared.map((item) => {
     if (item.kind === "artist") return { kind: item.kind, name: artists.get(item.name) ?? item.name };
-    if (item.kind === "track") return { kind: item.kind, name: tracks.get(item.name) ?? item.name.split(" | ")[0] };
+    // A key is "title|artist"; without a spelling on file, show the title, never the raw key.
+    if (item.kind === "track") return { kind: item.kind, name: tracks.get(item.name) ?? item.name.split("|")[0] };
     return { kind: item.kind, name: item.name };
   });
 }

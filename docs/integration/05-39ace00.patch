     }
     const outcome = wasRejected ? "published" : priceChanged || timeChanged ? "updated" : "duplicate";
     return {
diff --git a/convex/plans/release.ts b/convex/plans/release.ts
index 4ae8864..0766df8 100644
--- a/convex/plans/release.ts
+++ b/convex/plans/release.ts
@@ -4,7 +4,7 @@ import { afterSeatOut, heldSeats, isActivePlan, planClock, seatsOf } from "./mod
 
 // Spotify disconnect (S16): gives up any seat the student was offered or holds (it reopens for the
 // partner) and closes their open asks, so no new asks or offers reach them.
-// INTEGRATION: stream A's settings.disconnectSpotify calls this.
+// stream A's settings.disconnectSpotify calls this.
 export const forUser = internalMutation({
   args: { userId: v.id("users") },
   returns: v.object({ seatsReleased: v.number(), asksClosed: v.number() }),
@@ -37,7 +37,7 @@ export const forUser = internalMutation({
 
 // The team pulled an event (S17): open asks for it close, and every plan for it that is still forming
 // or set is called off. An offer is withdrawn, not declined, so it goes out as no_answer.
-// INTEGRATION: stream B's convex/events/admin.ts calls this when an event is pulled.
+// stream B's convex/events/admin.ts calls this when an event is pulled.
 export const forEvent = internalMutation({
   args: { eventId: v.id("events") },
   returns: v.object({ asksClosed: v.number(), plansCalledOff: v.number(), offersWithdrawn: v.number() }),
diff --git a/convex/plans/retime.ts b/convex/plans/retime.ts
index 01f4a56..de10bdf 100644
--- a/convex/plans/retime.ts
+++ b/convex/plans/retime.ts
@@ -6,7 +6,7 @@ import { reconcilePlan } from "./reconcile";
 // An event's start time or meeting offset changed: every plan still forming or set gets the new
 // meeting time and cutoff, is reconciled at once (offers now past the cutoff expire, an empty seat past
 // it calls the plan off), and has its time boundaries rescheduled. Reconcile reads now(forDemo).
-// INTEGRATION: stream B's convex/events/imports.ts and admin edits call this after changing the times.
+// stream B's convex/events/imports.ts and admin edits call this after changing the times.
 export const forEvent = internalMutation({
   args: { eventId: v.id("events") },
   returns: v.object({ plansRetimed: v.number() }),

From baca044c5d6fea510303261c6b90899c7ecbbbe9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 25 Oct 2026 02:25:05 +0000
Subject: [PATCH] wire: webhook route, first asks after confirm, seats released
 on disconnect, asks after an import

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015guTYUBX4Ct5WtjQ9sW1zv
---
 convex/events/imports.ts      | 2 +-
 convex/http.ts                | 4 ++++
 convex/onboarding/analysis.ts | 2 +-
 convex/settings.ts            | 4 +++-
 4 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/convex/events/imports.ts b/convex/events/imports.ts
index dc9e7d7..ba89723 100644
--- a/convex/events/imports.ts
+++ b/convex/events/imports.ts
@@ -323,7 +323,7 @@ export const finish = internalMutation({
   handler: async (ctx, { importId, counts, errors }) => {
     await ctx.db.patch(importId, { status: "done", counts, errors: errors.slice(0, 50), finishedAt: Date.now() });
     if (counts.published > 0) {
-      // INTEGRATION: ctx.scheduler.runAfter(0, internal.asks.picker.pickAfterImport, {});
+      await ctx.scheduler.runAfter(0, internal.asks.picker.pickAfterImport, {});
     }
     return null;
   },
diff --git a/convex/http.ts b/convex/http.ts
index 1816e5b..373a0ec 100644
--- a/convex/http.ts
+++ b/convex/http.ts
@@ -1,8 +1,12 @@
 import { httpRouter } from "convex/server";
 import { auth } from "./auth";
+import { apifyWebhook } from "./events/webhook";
 
 const http = httpRouter();
 
 auth.addHttpRoutes(http);
 
+// Apify calls this when an event scout run succeeds (§6.1); the handler checks the shared secret.
+http.route({ path: "/apify/webhook", method: "POST", handler: apifyWebhook });
+
 export default http;
diff --git a/convex/onboarding/analysis.ts b/convex/onboarding/analysis.ts
index 75c8ff8..dd76c35 100644
--- a/convex/onboarding/analysis.ts
+++ b/convex/onboarding/analysis.ts
@@ -460,7 +460,7 @@ export const embedComplete = internalMutation({
   handler: async (ctx, { context }) => {
     const user = await ctx.db.get(context.userId);
     if (user?.onboarding !== "ready") return null;
-    // INTEGRATION: ctx.scheduler.runAfter(0, internal.asks.picker.pickForUser, { userId: context.userId });
+    await ctx.scheduler.runAfter(0, internal.asks.picker.pickForUser, { userId: context.userId });
     return null;
   },
 });
diff --git a/convex/settings.ts b/convex/settings.ts
index aa4af39..c3997a3 100644
--- a/convex/settings.ts
+++ b/convex/settings.ts
@@ -1,4 +1,5 @@
 import { mutation } from "./_generated/server";
+import { internal } from "./_generated/api";
 import { v } from "convex/values";
 import { requireVerifiedUser } from "./lib/access";
 import { accessFor } from "./onboarding/apps";
@@ -30,7 +31,8 @@ export const disconnectSpotify = mutation({
       user.onboarding === "ready";
     if (reachedConnect) await ctx.db.patch(userId, { onboarding: "needs_spotify_connect" });
 
-    // INTEGRATION: await ctx.runMutation(internal.plans.release.forUser, { userId }); gives up any seat (it reopens) and closes asks.
+    // Gives up any seat (it reopens for the partner) and closes asks, in the same transaction.
+    await ctx.runMutation(internal.plans.release.forUser, { userId });
     return null;
   },
 });
-- 

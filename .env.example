# Names only. Never commit values.

# --- Next.js (.env.local, written by `npx convex dev`) ---
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# --- Convex deployment environment (set in the Convex dashboard or with scripts/push-secrets.sh) ---
# Convex Auth (already set on dev)
SITE_URL=
JWT_PRIVATE_KEY=
JWKS=
# Email codes and the Spotify-ready notice
AUTH_RESEND_KEY=
# Claude and embeddings
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Event agent
APIFY_TOKEN=
APIFY_WEBHOOK_SECRET=
# Spotify: one client secret per app, named by its label (for example SPOTIFY_CLIENT_SECRET_MELOS_ALEX)
SPOTIFY_STATE_SECRET=
SPOTIFY_CLIENT_SECRET_LABEL=
# Team emails, comma-separated
ADMIN_EMAILS=

# --- Vercel (project settings, Production only) ---
CONVEX_DEPLOY_KEY=
